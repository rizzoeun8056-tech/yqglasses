---
interface Props {
  shareImage?: string;
  shareImageType?: string;
  shareImageWidth?: number;
  shareImageHeight?: number;
  shareImageAlt?: string;
}
const {
  shareImage = 'https://yqglasses.com/images/brand/social-share-v2-1200x630.jpg',
  shareImageType = 'image/jpeg', shareImageWidth = 1200, shareImageHeight = 630,
  shareImageAlt = 'YQ GLASSES — Champagne Flutes & Cake Serving Sets',
} = Astro.props;
---

<link rel="icon" href="/favicon-yq-color-v3.ico" sizes="16x16 32x32 48x48 64x64" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-yq-color-v3-32.png" />
<link rel="icon" type="image/svg+xml" href="/favicon-yq-color-v3.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta property="og:image" content={shareImage} />
<meta property="og:image:type" content={shareImageType} />
<meta property="og:image:width" content={String(shareImageWidth)} />
<meta property="og:image:height" content={String(shareImageHeight)} />
<meta property="og:image:alt" content={shareImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={shareImage} />
<meta name="twitter:image:alt" content={shareImageAlt} />
