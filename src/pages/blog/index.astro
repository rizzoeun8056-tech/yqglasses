---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BrandAssets from '../../components/BrandAssets.astro';
import { blogCategories, blogPosts } from '../../data/blog';

const title = 'Blog | Glassware & Cake Serving Guides | YQ GLASSES';
const description = 'Practical guides to cake serving sets, glassware and personalized details from YQ GLASSES.';
const pageSize = 9;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://yqglasses.com/blog/" />
    <link rel="canonical" href="https://yqglasses.com/blog/" />
    <BrandAssets />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <header class="journal-heading">
        <img class="journal-banner" src="/images/blog/celebration-table-banner.webp" alt="" width="600" height="200" fetchpriority="high" />
        <h1>Blog</h1>
      </header>
      <div class="journal page-width">
      <div class="journal-tabs" role="tablist" aria-label="Blog topics">
        {blogCategories.map((category, index) => (
          <button type="button" role="tab" id={`tab-${category.id}`} aria-controls={`panel-${category.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-blog-category={category.id}>{category.label}</button>
        ))}
      </div>
      {blogCategories.map((category, index) => (
        <section class="journal-panel" id={`panel-${category.id}`} role="tabpanel" aria-labelledby={`tab-${category.id}`} tabindex="0" data-page-size={pageSize} hidden={index !== 0}>
          <div class="journal-grid">
            {blogPosts.filter((post) => post.category === category.id).map((post, postIndex) => (
              <article class="journal-card" hidden={postIndex >= pageSize}>
                <a class="journal-card-link" href={`/blog/${post.slug}/`}>
                  <h2>{post.title} <span aria-hidden="true">↗</span></h2><p>{post.description}</p>
                </a>
              </article>
            ))}
          </div>
          <p class="journal-empty" hidden={blogPosts.some((post) => post.category === category.id)}>Articles coming soon.</p>
          <nav class="journal-pagination" aria-label={`${category.label} article pages`} hidden>
            <button type="button" data-page-previous aria-label="Previous page">← Previous</button>
            <div class="journal-page-numbers"></div>
            <button type="button" data-page-next aria-label="Next page">Next →</button>
            <span class="journal-page-status" aria-live="polite" aria-atomic="true"></span>
          </nav>
        </section>
      ))}
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .journal { max-width: 1080px; padding-block: 40px 88px; }
  .journal-heading { position: relative; width: 100%; aspect-ratio: 3 / 1; min-height: 180px; overflow: hidden; background: var(--brand-surface); }
  .journal-banner { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  h1 { position: absolute; top: 26%; left: 50%; transform: translate(-50%, -50%); margin: 0; font-size: var(--font-size-h1); line-height: 1.1; color: var(--brand-ink); }
  .journal-tabs { display: flex; justify-content: center; gap: 8px; margin-bottom: 36px; }
  .journal-tabs button { min-height: 46px; padding: 12px 22px; border: 1px solid var(--line); border-radius: 3px; background: var(--brand-surface); color: var(--ink); font-size: 14px; line-height: 1.5; }
  .journal-tabs button[aria-selected='true'] { border-color: var(--copper); background: var(--brand-copper); color: #fff; }
  .journal-tabs button:hover { border-color: var(--copper); }
  .journal-panel[hidden], .journal-card[hidden], .journal-pagination[hidden], .journal-empty[hidden] { display: none; }
  .journal-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .journal-card { border-top: 1px solid var(--line); }
  .journal-card-link { display: block; height: 100%; padding: 24px 0 18px; }
  h2 { margin-bottom: 14px; font-size: 24px; line-height: 1.3; }
  h2 span { color: var(--copper-dark); font-family: Arial, sans-serif; font-size: 18px; white-space: nowrap; }
  .journal-card-link:hover h2 { color: var(--copper-dark); }
  .journal-card p, .journal-empty { margin-bottom: 0; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .journal-empty { text-align: center; padding-block: 32px; }
  .journal-pagination { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 40px; }
  .journal-pagination button { min-height: 42px; min-width: 42px; padding: 9px 12px; border: 1px solid var(--line); background: var(--brand-paper); color: var(--ink); font-size: 14px; }
  .journal-pagination button[aria-current='page'] { background: var(--brand-copper); border-color: var(--copper); color: #fff; }
  .journal-pagination button:disabled { color: var(--muted); cursor: default; }
  .journal-page-numbers { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
  .journal-page-status { flex-basis: 100%; text-align: center; color: var(--muted); font-size: 14px; line-height: 1.5; }
  @media (min-width: 701px) and (max-width: 980px) { .journal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    .journal { padding-block: 30px 60px; }
    .journal-tabs { gap: 6px; margin-bottom: 28px; }
    .journal-tabs button { flex: 1; padding: 10px 8px; }
    .journal-grid { grid-template-columns: 1fr; gap: 32px; }
    h2 { font-size: 22px; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-blog-category]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.journal-panel'));
  const currentPages = new Map<string, number>();
  const saveLocation = (category: string, page: number) => {
    const url = new URL(window.location.href);
    url.hash = category;
    if (page > 1) url.searchParams.set('page', String(page));
    else url.searchParams.delete('page');
    window.history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
  };
  const renderPage = (panel: HTMLElement, requestedPage: number) => {
    const cards = Array.from(panel.querySelectorAll<HTMLElement>('.journal-card'));
    const pageSize = Number(panel.dataset.pageSize);
    const pageCount = Math.max(1, Math.ceil(cards.length / pageSize));
    const page = Math.min(pageCount, Math.max(1, Math.trunc(requestedPage) || 1));
    currentPages.set(panel.id, page);
    cards.forEach((card, index) => { card.hidden = index < (page - 1) * pageSize || index >= page * pageSize; });
    const pagination = panel.querySelector<HTMLElement>('.journal-pagination')!;
    pagination.hidden = pageCount <= 1;
    const numbers = panel.querySelector<HTMLElement>('.journal-page-numbers')!;
    numbers.replaceChildren();
    for (let number = 1; number <= pageCount; number++) {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = String(number);
      button.dataset.page = String(number);
      button.setAttribute('aria-label', `Page ${number}`);
      if (number === page) button.setAttribute('aria-current', 'page');
      numbers.append(button);
    }
    panel.querySelector<HTMLButtonElement>('[data-page-previous]')!.disabled = page === 1;
    panel.querySelector<HTMLButtonElement>('[data-page-next]')!.disabled = page === pageCount;
    panel.querySelector<HTMLElement>('.journal-page-status')!.textContent = `Page ${page} of ${pageCount}`;
    return page;
  };
  panels.forEach((panel) => {
    renderPage(panel, 1);
    panel.querySelector('.journal-pagination')!.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>('button');
      if (!button || button.disabled) return;
      const previousPage = currentPages.get(panel.id) || 1;
      const requestedPage = button.hasAttribute('data-page-next') ? previousPage + 1 : button.hasAttribute('data-page-previous') ? previousPage - 1 : Number(button.dataset.page);
      const page = renderPage(panel, requestedPage);
      const tab = tabs.find((tab) => tab.getAttribute('aria-controls') === panel.id)!;
      saveLocation(tab.dataset.blogCategory!, page);
      panel.focus({ preventScroll: true });
      panel.scrollIntoView({ block: 'start', behavior: 'instant' });
    });
  });
  const selectCategory = (selected: HTMLButtonElement, page = 1) => {
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls') || '');
      if (panel) {
        panel.hidden = !active;
        if (active) renderPage(panel, page);
      }
    });
  };
  const selectFromHash = () => {
    const selected = tabs.find((tab) => tab.dataset.blogCategory === window.location.hash.slice(1)) || tabs[0];
    const requestedPage = Number(new URLSearchParams(window.location.search).get('page')) || 1;
    if (selected) selectCategory(selected, requestedPage);
  };
  selectFromHash();
  window.addEventListener('hashchange', selectFromHash);
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      selectCategory(tab);
      saveLocation(tab.dataset.blogCategory!, 1);
    });
    tab.addEventListener('keydown', (event) => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectCategory(tabs[next]);
      saveLocation(tabs[next].dataset.blogCategory!, 1);
      tabs[next].focus();
    });
  });
</script>
