---
import '../../styles/global.css';
import '../../styles/cake-knife-product.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BrandAssets from '../../components/BrandAssets.astro';
import { site } from '../../data/site';

const title = 'Custom Cake Knife and Server Sets | YQ GLASSES';
const description = 'Explore custom cake knife and server sets with engraving, decorative handles and gift packaging. Compare styles and plan your wholesale order.';
const keywords = 'custom cake knife and server sets, wedding cake knife and server set, wholesale cake serving sets, engraved cake knife set, cake knife gift packaging';
const canonical = new URL('/cake-knife-server-sets/', Astro.site).href;
const socialImage = new URL('/images/cake-knife-sets/rose-pair.webp', Astro.site).href;
const inquiryHref = `${site.inquiryUrl}?${new URLSearchParams({ product: 'Cake Knife & Server Sets', order_type: 'custom', design: 'Rose handles' }).toString()}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f1eb" />
    <meta name="robots" content="index, follow" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Gold-tone cake knife and server with rose-shaped handles" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="image" href="/images/cake-knife-sets/rose-pair.webp" />
    <BrandAssets />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <div id="yq-cake-page" aria-label="YQ GLASSES cake knife and server collection" data-inquiry-url={site.inquiryUrl}>
<main id="main">
    
    <section class="yq-wrap yq-hero" aria-labelledby="yq-title">
      <div>
        
        <h1 id="yq-title">Custom cake knife<br>&amp; server sets.<em>Made personal.</em></h1>
        <p>Matching knife and server sets for weddings, gifts and retail collections. Choose your style, add engraving and finish with packaging made for your project.</p>
        <ul class="yq-tags yq-hero-tags" aria-label="Product highlights"><li>2-piece sets</li><li>Stock &amp; custom orders</li><li>Personalized engraving</li></ul>
        <a class="yq-primary" href="#quote">Request a Custom Quote <span class="yq-arrow" aria-hidden="true">↗</span></a>
      </div>
      <figure>
        <div class="yq-hero-photo"><img id="yq-hero-image" src="/images/cake-knife-sets/rose-pair.webp" alt="Gold-tone cake knife and server with sculptural rose and leaf handles" width="600" height="600" fetchpriority="high"></div>
        
      </figure>
    </section>

    <section class="yq-section" id="collection" aria-labelledby="yq-collection-title">
      <div class="yq-wrap">
        <div class="yq-section-head"><div><h2 id="yq-collection-title">A style for<br><em>your celebration.</em></h2></div></div>
        <div class="yq-collection-grid">
          <article class="yq-product" data-style="faceted"><div class="yq-product-photo"><img src="/images/cake-knife-sets/faceted-pair.webp" alt="Silver-tone cake knife and server with clear faceted handle ends" width="600" height="600" loading="lazy"></div><h3>Faceted handles</h3><p>A light-catching look for understated table settings.</p><ul class="yq-tags"><li>Clear handles</li><li>Faceted ends</li></ul><button class="yq-text-link" type="button" data-select-style="faceted">Explore this style <span aria-hidden="true">↗</span></button></article>
          <article class="yq-product" data-style="decorated"><div class="yq-product-photo"><img src="/images/cake-knife-sets/studded-pair.webp" alt="Cake knife and server with hand-decorated sparkling silver-colored handles" width="600" height="600" loading="lazy"></div><h3>Hand-decorated handles</h3><p>Sparkling handle details for weddings and gift collections.</p><ul class="yq-tags"><li>Stainless steel</li><li>Studded detail</li></ul><button class="yq-text-link" type="button" data-select-style="decorated">Explore this style <span aria-hidden="true">↗</span></button></article>
          <article class="yq-product" data-style="rose"><div class="yq-product-photo"><img src="/images/cake-knife-sets/rose-pair.webp" alt="Gold-tone cake knife and server with rose-shaped metal handles" width="600" height="600" loading="lazy"></div><h3>Rose handles</h3><p>Sculptural roses and leaves for a romantic presentation.</p><ul class="yq-tags"><li>Zinc alloy design</li><li>Gold electroplating</li></ul><button class="yq-text-link" type="button" data-select-style="rose">Explore this style <span aria-hidden="true">↗</span></button></article>
        </div>
        <dl class="yq-spec-strip"><div><dt>Set contents</dt><dd>1 cake knife + 1 cake server</dd></div><div><dt>Metal options</dt><dd>Stainless steel · Zinc alloy</dd></div><div><dt>Handle options</dt><dd>Acrylic · Hollow acrylic · Metal</dd></div></dl>
        <p class="yq-small-note">Materials, dimensions and available combinations are confirmed for your selected design.</p>
      </div>
    </section>

    <section class="yq-section yq-occasions" id="occasions" aria-labelledby="yq-occasions-title">
      <div class="yq-wrap">
        <div class="yq-section-head"><div><h2 id="yq-occasions-title">Moments worth<br><em>celebrating.</em></h2></div></div>
        <figure><div class="yq-scene-photo"><img src="/images/cake-knife-sets/wedding-scene-silver-studded.webp" alt="Wedding styling concept with an ivory cake, champagne glasses and a silver cake knife and server with sparkling studded handles" width="1280" height="667" loading="lazy"></div></figure>
        <div class="yq-occasion-grid">
          <article class="yq-occasion"><h3>Weddings</h3><p>Names, dates and a coordinated cake table.</p></article>
          <article class="yq-occasion"><h3>Anniversaries</h3><p>A meaningful date or personal message.</p></article>
          <article class="yq-occasion"><h3>Personal gifts</h3><p>A matching set in a gift box.</p></article>
          <article class="yq-occasion"><h3>Retail collections</h3><p>Your style, branding and packaging direction.</p></article>
        </div>
      </div>
    </section>

    <section class="yq-section" id="craft" aria-labelledby="yq-craft-title">
      <div class="yq-wrap yq-split">
        <figure class="yq-detail-photo"><img src="/images/cake-knife-sets/studded-detail.webp" alt="Close-up of hand-decorated sparkling cake knife and server handles" width="600" height="600" loading="lazy"></figure>
        <div class="yq-split-copy"><h2 id="yq-craft-title">Texture.<br><em>Sparkle. Character.</em></h2><p>Studded handles give this stainless steel set a distinctive finish, with coordinated details across the knife and server.</p><ul class="yq-feature-points"><li>Decorative handle patterns</li><li>Matching knife and server styling</li><li>Grip, finish and assembly reviewed with your sample</li></ul><p class="yq-small-note">Decorative materials and care instructions vary by design.</p></div>
      </div>
    </section>

    <section class="yq-section yq-custom-section" id="customization" aria-labelledby="yq-custom-title">
      <div class="yq-wrap">
        <div class="yq-section-head"><div><h2 id="yq-custom-title">Choose the details.<br><em>Make it yours.</em></h2></div></div>
        <div class="yq-custom-grid">
          <div class="yq-custom-tabs" role="tablist" aria-label="Customization options" aria-orientation="vertical">
            <button class="yq-custom-tab" id="yq-tab-handles" type="button" role="tab" aria-selected="true" aria-controls="yq-custom-panel" data-custom="handles"><span><strong>Handles &amp; decoration</strong><span class="yq-tab-copy">Materials, shapes and decorative details.</span></span><span class="yq-arrow" aria-hidden="true">↗</span></button>
            <button class="yq-custom-tab" id="yq-tab-finishes" type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="yq-custom-panel" data-custom="finishes"><span><strong>Metal finishes</strong><span class="yq-tab-copy">Color and surface treatment to suit your design.</span></span><span class="yq-arrow" aria-hidden="true">↗</span></button>
            <button class="yq-custom-tab" id="yq-tab-engraving" type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="yq-custom-panel" data-custom="engraving"><span><strong>Personalized engraving</strong><span class="yq-tab-copy">Names, dates, messages or a brand logo.</span></span><span class="yq-arrow" aria-hidden="true">↗</span></button>
            <button class="yq-custom-tab" id="yq-tab-packaging" type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="yq-custom-panel" data-custom="packaging"><span><strong>Packaging to match</strong><span class="yq-tab-copy">Gift or standard boxes with your design.</span></span><span class="yq-arrow" aria-hidden="true">↗</span></button>
          </div>
          <div class="yq-custom-visual" id="yq-custom-panel" role="tabpanel" aria-labelledby="yq-tab-handles">
            <img id="yq-custom-image" src="/images/cake-knife-sets/rose-pair.webp" alt="Selected rose-handle cake knife and server design" width="600" height="600" loading="lazy">
            <div class="yq-engraving-example" id="yq-engraving-sample" hidden><strong>Emma &amp; James</strong><span>14 · 06 · 2027</span></div>
            
            <div class="yq-custom-guidance" data-guidance="handles"><h3>Handle options</h3><ul><li>Acrylic, hollow acrylic or metal</li><li>Share a shape or decoration reference</li><li>New shapes may require mold development</li></ul></div>
            <div class="yq-custom-guidance" data-guidance="finishes" hidden><h3>Finish options</h3><ul><li>Share your preferred color and sheen</li><li>Confirm treatment by component</li><li>Review the finish on a product sample</li></ul></div>
            <div class="yq-custom-guidance" data-guidance="engraving" hidden><h3>Engraving details</h3><ul><li>Send exact text or logo artwork</li><li>Choose the position and approximate size</li><li>Confirm layout and sample effect</li></ul></div>
            <div class="yq-custom-guidance" data-guidance="packaging" hidden><h3>Packaging options</h3><ul><li>Gift boxes or standard boxes</li><li>Custom shape, design and wording</li><li>Confirm box fit, materials and artwork</li></ul></div>
          </div>
        </div>
        <p class="yq-small-note">Available options, sample requirements and costs are confirmed for your design before production.</p>
      </div>
    </section>

    <section class="yq-section yq-why" id="why-yq" aria-labelledby="yq-why-title">
      <div class="yq-wrap yq-why-layout">
        <div class="yq-why-intro"><h2 id="yq-why-title">A team behind<br><em>every order.</em></h2></div>
        <div class="yq-reason-grid">
          <article class="yq-reason"><h3>Assembly</h3><p>Your chosen components brought together.</p></article>
          <article class="yq-reason"><h3>Inspection</h3><p>Products reviewed before packing.</p></article>
          <article class="yq-reason"><h3>Packing</h3><p>Sets prepared in the agreed boxes.</p></article>
          <article class="yq-reason"><h3>Order updates</h3><p>Progress updates through each stage.</p></article>
        </div>
      </div>
    </section>

    <section class="yq-section yq-packaging" id="packaging" aria-labelledby="yq-pack-title">
      <div class="yq-wrap yq-split">
        <div class="yq-split-copy"><h2 id="yq-pack-title">The set.<br><em>The presentation.</em></h2><p>Complete your set with packaging for gifting, retail or events.</p><ul class="yq-tags yq-packaging-tags"><li>Gift boxes</li><li>Standard boxes</li></ul><dl class="yq-pack-specs"><div><dt>Shape</dt><dd>Box format and fit</dd></div><div><dt>Design</dt><dd>Your artwork and brand style</dd></div><div><dt>Text</dt><dd>Names, messages or product wording</dd></div></dl><p class="yq-small-note">Box materials and final packing details are confirmed with your order.</p></div>
        <figure class="yq-pack-photo"><img id="yq-gift-image" src="/images/cake-knife-sets/gift-box.webp" alt="Gold rose-handle cake knife and server in a black window gift box" width="600" height="600" loading="lazy"></figure>
      </div>
    </section>

    <section class="yq-section yq-process" id="process" aria-labelledby="yq-process-title">
      <div class="yq-wrap">
        <div class="yq-section-head"><div><h2 id="yq-process-title">Your order.<br><em>Four clear steps.</em></h2></div></div>
        <div class="yq-step-grid">
          <article class="yq-step"><div class="yq-step-num">01</div><h3>Share your brief</h3><p>Style, quantity, customization and destination.</p></article>
          <article class="yq-step"><div class="yq-step-num">02</div><h3>Review the quote</h3><p>Confirm specifications, packaging, costs and timing.</p></article>
          <article class="yq-step"><div class="yq-step-num">03</div><h3>Confirm the sample</h3><p>Review the finish, engraving and product details.</p></article>
          <article class="yq-step"><div class="yq-step-num">04</div><h3>Prepare for dispatch</h3><p>Assembly, inspection and packing with progress updates.</p></article>
        </div>
        <div class="yq-sample-check"><h3>Sample checkpoints</h3><ul class="yq-tags"><li>Size &amp; grip</li><li>Finish &amp; assembly</li><li>Engraving</li><li>Box fit</li></ul></div>
        <div class="yq-lead-layout" id="lead-times">
          <div><h3>Lead times<br><em>at a glance.</em></h3><p>Share your required arrival date and destination. Final timing depends on design, quantity and packaging.</p></div>
          <div><table class="yq-timing-table"><caption>Dispatch, sampling and production</caption><thead><tr><th scope="col">Order stage</th><th scope="col">Planning range</th></tr></thead><tbody><tr><th scope="row">In-stock dispatch</th><td>1–3 days</td></tr><tr><th scope="row">Bulk stock dispatch</th><td>3–7 days</td></tr><tr><th scope="row">Custom samples*</th><td>3–7 days</td></tr><tr><th scope="row">Custom bulk production</th><td>5–25 days</td></tr></tbody></table><p class="yq-small-note">*For samples requiring mold development; mold scope and timing are confirmed separately. Shipping transit is additional.</p></div>
        </div>
      </div>
    </section>

    <section class="yq-section" id="faq" aria-labelledby="yq-faq-title">
      <div class="yq-wrap yq-faq-layout">
        <div class="yq-faq-intro"><h2 id="yq-faq-title">A few<br><em>useful answers.</em></h2></div>
        <div class="yq-faq-list">
          <details open><summary>What is included in a set?</summary><p>One cake knife and one matching server. Dimensions, materials and packaging are confirmed for the selected design.</p></details>
          <details><summary>Can you engrave names, dates or a logo?</summary><p>Yes. Send your text or artwork, preferred position and size. We confirm the layout and engraving approach for the product.</p></details>
          <details><summary>What is the minimum order quantity?</summary><p>Minimums depend on the style, customization and packaging. Share your estimated quantity so we can confirm.</p></details>
          <details><summary>Can I request a sample?</summary><p>Yes. Sample availability, cost and timing are confirmed for your design. New shapes may require separately quoted mold development.</p></details>
          <details><summary>Can I customize the gift box?</summary><p>Yes. Gift and standard boxes support custom shape, design and wording. Materials, fit and artwork are confirmed with your order.</p></details>
          <details><summary>Are the sets dishwasher safe?</summary><p>Care depends on the finish, decoration and handle construction. Confirm model-specific instructions; use gentle hand washing and prompt drying until confirmed.</p></details>
          <details><summary>What product specifications can I request?</summary><p>Ask for component materials, knife and server dimensions, handle details and care instructions. Share any product-document requirements with your inquiry.</p></details>
          <details><summary>Does the lead time include shipping?</summary><p>No. The ranges above cover dispatch, sampling or production. Transit is additional; include your destination and required arrival date.</p></details>
        </div>
      </div>
    </section>

    <section class="yq-wrap yq-quote" id="quote" aria-labelledby="yq-quote-title">
      <div class="yq-quote-inner"><h2 id="yq-quote-title">Let’s create<br><em>your set.</em></h2><p>Send your preferred style and project details for a tailored quotation.</p><ul class="yq-tags yq-quote-tags" aria-label="Inquiry checklist"><li>Quantity</li><li>Engraving or logo</li><li>Packaging</li><li>Destination &amp; date</li></ul><a class="yq-primary" data-quote-link href={inquiryHref}>Request a Custom Quote <span class="yq-arrow" aria-hidden="true">↗</span></a><p class="yq-quote-note" id="yq-quote-selection" aria-live="polite">Selected starting style: Rose handles</p><p class="yq-quote-note">Reference photos, sketches and artwork welcome.</p></div>
    </section>
  </main>
    </div>
    <SiteFooter />

  <script>
    const root = document.getElementById('yq-cake-page');
    if (root) {
      const styles = {
        rose: { name: 'Rose handles', alt: 'Gold-tone cake knife and server with rose-shaped handles' },
        faceted: { name: 'Faceted handles', alt: 'Silver-tone cake knife and server with clear faceted handle ends' },
        decorated: { name: 'Hand-decorated handles', alt: 'Cake knife and server with hand-decorated sparkling handles' },
      };
      type Style = keyof typeof styles;
      const modes = ['handles', 'finishes', 'engraving', 'packaging'] as const;
      type Mode = typeof modes[number];
      let selectedStyle: Style = 'rose';
      let selectedMode: Mode = 'handles';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-custom]'));
      const visual = root.querySelector<HTMLImageElement>('#yq-custom-image');
      const sample = root.querySelector<HTMLElement>('#yq-engraving-sample');
      const panel = root.querySelector<HTMLElement>('#yq-custom-panel');
      const selection = root.querySelector<HTMLElement>('#yq-quote-selection');
      const imageFor = (style: Style) => root.querySelector<HTMLImageElement>(`[data-style="${style}"] img`);

      function render() {
        tabs.forEach((tab) => {
          const active = tab.dataset.custom === selectedMode;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
        });
        panel?.setAttribute('aria-labelledby', `yq-tab-${selectedMode}`);
        root!.querySelectorAll<HTMLElement>('[data-guidance]').forEach((item) => {
          item.hidden = item.dataset.guidance !== selectedMode;
        });
        root!.querySelectorAll<HTMLAnchorElement>('[data-quote-link]').forEach((link) => {
          const params = new URLSearchParams({
            product: 'Cake Knife & Server Sets',
            order_type: 'custom',
            design: styles[selectedStyle].name,
          });
          link.href = `${root!.dataset.inquiryUrl || '/file-upload/'}?${params.toString()}`;
        });
        if (selection) selection.textContent = `Selected starting style: ${styles[selectedStyle].name}`;
        const engraving = selectedMode === 'engraving';
        if (sample) sample.hidden = !engraving;
        if (visual) {
          visual.hidden = engraving;
          const image = selectedMode === 'packaging'
            ? root!.querySelector<HTMLImageElement>('#yq-gift-image')
            : imageFor(selectedMode === 'finishes' ? 'rose' : selectedStyle);
          if (!engraving && image) {
            visual.src = image.src;
            visual.alt = image.alt;
          }
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          const mode = tab.dataset.custom as Mode;
          if (modes.includes(mode)) { selectedMode = mode; render(); }
        });
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1
            : (index + (event.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
          tabs[next].focus();
          selectedMode = tabs[next].dataset.custom as Mode;
          render();
        });
      });
      root.querySelectorAll<HTMLButtonElement>('[data-select-style]').forEach((button) => {
        button.addEventListener('click', () => {
          const style = button.dataset.selectStyle;
          if (!style || !(style in styles)) return;
          selectedStyle = style as Style;
          selectedMode = 'handles';
          render();
          root.querySelector('#customization')?.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
            block: 'start',
          });
        });
      });
      render();
    }
  </script>
  </body>
</html>
