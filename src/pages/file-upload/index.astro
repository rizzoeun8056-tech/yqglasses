---
import '../../styles/global.css';
import { site } from '../../data/site';
import Brand from '../../components/Brand.astro';
import BrandAssets from '../../components/BrandAssets.astro';

const year = new Date().getFullYear();
const contactHref = 'mailto:' + site.contactEmail + '?subject=YQ%20GLASSES%20Wholesale%20Inquiry';

const products = [
  'Champagne Flutes',
  'Cake Knife & Server Sets',
  'Beer Glasses',
  'Shot Glasses',
  'Cocktail Glasses',
  'Whiskey Glasses',
  'Coordinated Gift Set',
  'Other / New Design',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f3e9" />
    <meta name="description" content="Share your glassware or serving-set requirements and upload reference files for a custom quotation from YQ GLASSES." />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="Request a Quote | YQ GLASSES" />
    <meta property="og:description" content="Send product details, target quantity and reference files for a practical project review." />
    <BrandAssets />
    <meta property="og:url" content="https://yqglasses.com/file-upload/" />
    <link rel="canonical" href="https://yqglasses.com/file-upload/" />
    <title>Request a Quote | YQ GLASSES</title>
  </head>
  <body class="inquiry-page">
    <a class="skip-link" href="#main">Skip to inquiry form</a>

    <header class="site-header" id="top">
      <div class="header-inner page-width">
        <Brand />
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="/#collections">Collections</a>
          <a href="/#customization">Customization</a>
          <a href="/#quality">Quality</a>
          <a href="/#faq">FAQ</a>
        </nav>
        <a class="header-cta is-current" href="#project-form">Start your inquiry <span aria-hidden="true">↓</span></a>
        <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu"><span></span><span></span><span></span></button>
      </div>
      <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
        <a href="/#collections">Collections</a><a href="/#customization">Customization</a><a href="/#quality">Quality</a><a href="/#faq">FAQ</a><a href="#project-form">Start your inquiry</a>
      </nav>
    </header>

    <main id="main">
      <section class="upload-hero" aria-labelledby="upload-hero-title">
        <img class="upload-hero-art" src="/images/reference/file-upload-banner.webp" alt="Concept sketches for champagne flutes, glassware, cake servers and tableware" width="800" height="450" fetchpriority="high" />
        <div class="page-width upload-hero-inner">
          <div class="upload-hero-copy">
            <p class="eyebrow"><span class="eyebrow-rule"></span> WHOLESALE & CUSTOM INQUIRY</p>
            <h1 id="upload-hero-title">Share your project.<br /><em>Get a clear next step.</em></h1>
            <p>Send your product idea, target quantity and any reference files. We will review the requirements and reply with practical options for quotation and sampling.</p>
            <dl class="upload-hero-points">
              <div><dt>01 / Share</dt><dd>Photos, sketches or artwork</dd></div>
              <div><dt>02 / Specify</dt><dd>Quantity, finish and packaging</dd></div>
              <div><dt>03 / Review</dt><dd>Feasibility and next steps</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section class="brief-section" aria-labelledby="brief-title">
        <div class="page-width brief-layout">
          <div class="brief-heading">
            <p class="eyebrow"><span class="eyebrow-rule"></span> PREPARE YOUR BRIEF</p>
            <h2 id="brief-title">A few details help us<br /><em>quote more accurately.</em></h2>
          </div>
          <p class="brief-intro">A technical drawing is helpful, but it is not required. Share what you have and describe the result you want.</p>
        </div>
        <div class="page-width brief-grid">
          <article><span>01</span><h3>Choose a product</h3><p>Select the closest product type and include your target quantity.</p></article>
          <article><span>02</span><h3>Describe the details</h3><p>Mention size, finish, logo, packaging, market or delivery timing.</p></article>
          <article><span>03</span><h3>Add reference files</h3><p>Upload photos, sketches, artwork or drawings if they help explain the idea.</p></article>
        </div>
      </section>

      <section class="project-form-section" id="project-form" aria-labelledby="form-title">
        <div class="page-width project-form-layout">
          <aside class="form-aside">
            <p class="eyebrow light"><span class="eyebrow-rule"></span> PROJECT REVIEW</p>
            <h2 id="form-title">Tell us what<br /><em>you need.</em></h2>
            <p>Complete the form and attach any useful references. Your inquiry will be sent directly to YQ GLASSES for review.</p>
            <div class="form-aside-note">
              <span aria-hidden="true">↗</span>
              <div><strong>Prefer email?</strong><a href={contactHref}>{site.contactEmail}</a></div>
            </div>
            <p class="privacy-note">Your files are used only to review your inquiry and are not published on the website.</p>
          </aside>

          <div class="project-form-card">
            <div class="form-status form-status-success" id="form-success" role="status" tabindex="-1" hidden>
              <strong>Thank you. Your inquiry has been sent.</strong>
              <span>We will review the details and reply to the email address you provided.</span>
            </div>
            <div class="form-status form-status-error" id="form-error" role="alert" tabindex="-1" hidden>
              <strong>We could not send the form.</strong>
              <span>Please check the fields and file limits, then try again or email us directly.</span>
            </div>

            <form class="project-form" action="/api/submit-inquiry.php" method="post" enctype="multipart/form-data">
              <div class="form-honeypot" aria-hidden="true">
                <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
              </div>
              <input type="hidden" name="source_page" value="YQ GLASSES inquiry page" />

              <fieldset>
                <legend>Project</legend>
                <div class="form-row">
                  <label>Product category <span aria-hidden="true">*</span>
                    <select name="interest" id="product-interest" required>
                      <option value="" disabled selected>Select a product</option>
                      {products.map((product) => <option value={product}>{product}</option>)}
                    </select>
                  </label>
                  <label>Estimated quantity
                    <input type="text" name="quantity" inputmode="numeric" maxlength="40" placeholder="e.g. 500 sets" />
                  </label>
                </div>
                <label>Project details <span aria-hidden="true">*</span>
                  <textarea name="message" rows="6" minlength="20" maxlength="3000" placeholder="Describe the product, size or capacity, finish, logo, packaging and timing." required></textarea>
                </label>
              </fieldset>

              <fieldset>
                <legend>Contact</legend>
                <div class="form-row">
                  <label>Your name <span aria-hidden="true">*</span>
                    <input type="text" name="name" autocomplete="name" maxlength="100" required />
                  </label>
                  <label>Business email <span aria-hidden="true">*</span>
                    <input type="email" name="email" autocomplete="email" maxlength="180" required />
                  </label>
                </div>
                <div class="form-row">
                  <label>Company
                    <input type="text" name="company" autocomplete="organization" maxlength="160" />
                  </label>
                  <label>WhatsApp / phone
                    <input type="tel" name="phone" autocomplete="tel" maxlength="60" placeholder="Include country code" />
                  </label>
                </div>
              </fieldset>

              <fieldset>
                <legend>Reference files</legend>
                <label class="upload-zone" for="attachments">
                  <span class="upload-icon" aria-hidden="true">↑</span>
                  <strong>Add photos, artwork or drawings</strong>
                  <small>PDF, JPG, PNG, WebP, AI, EPS, SVG, CAD or ZIP · up to 3 files · 5 MB each</small>
                  <input id="attachments" type="file" name="attachments[]" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.ai,.eps,.svg,.dwg,.dxf,.step,.stp,.iges,.igs,.zip" aria-describedby="file-list" />
                </label>
                <div class="file-list" id="file-list" aria-live="polite">No files selected.</div>
              </fieldset>

              <div class="submit-row">
                <button class="button button-copper" type="submit">Submit inquiry <span aria-hidden="true">↗</span></button>
                <p>Required fields are marked with *</p>
              </div>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-width footer-main">
        <div><Brand footer /><p>Wholesale glassware and serving sets, thoughtfully made for your collection.</p></div>
        <div class="footer-links"><a href="/#collections">Collections</a><a href="/#customization">Customization</a><a href="/#quality">Quality</a><a href="#project-form">Inquiry form</a></div>
      </div>
      <div class="page-width footer-bottom"><span>© {year} YQ GLASSES</span><span>yqglasses.com</span><a href="#top">Back to top ↑</a></div>
    </footer>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
      if (menuButton && mobileMenu) {
        const closeMenu = () => { menuButton.setAttribute('aria-expanded', 'false'); menuButton.setAttribute('aria-label', 'Open menu'); mobileMenu.hidden = true; };
        menuButton.addEventListener('click', () => {
          const open = menuButton.getAttribute('aria-expanded') === 'true';
          menuButton.setAttribute('aria-expanded', String(!open));
          menuButton.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
          mobileMenu.hidden = open;
        });
        mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
        window.addEventListener('resize', () => { if (window.innerWidth > 860) closeMenu(); });
      }

      const params = new URLSearchParams(window.location.search);
      const product = params.get('product');
      const select = document.querySelector<HTMLSelectElement>('#product-interest');
      if (product && select && Array.from(select.options).some((option) => option.value === product)) select.value = product;

      const success = document.querySelector<HTMLElement>('#form-success');
      const error = document.querySelector<HTMLElement>('#form-error');
      const status = params.get('status');
      if (status === 'success' && success) {
        success.hidden = false;
        success.focus();
        document.querySelector<HTMLFormElement>('.project-form')?.reset();
      }
      if ((status === 'error' || status === 'invalid' || status === 'files') && error) {
        error.hidden = false;
        if (status === 'files') error.querySelector('span')!.textContent = 'Please use no more than 3 supported files, with each file under 5 MB.';
        if (status === 'invalid') error.querySelector('span')!.textContent = 'Please complete the required fields and check the email address.';
        error.focus();
      }

      const fileInput = document.querySelector<HTMLInputElement>('#attachments');
      const fileList = document.querySelector<HTMLElement>('#file-list');
      fileInput?.addEventListener('change', () => {
        if (!fileList || !fileInput.files?.length) {
          if (fileList) fileList.textContent = 'No files selected.';
          return;
        }
        const files = Array.from(fileInput.files);
        fileList.textContent = files.map((file) => file.name + ' (' + (file.size / 1024 / 1024).toFixed(1) + ' MB)').join(' · ');
      });
    </script>
  </body>
</html>
